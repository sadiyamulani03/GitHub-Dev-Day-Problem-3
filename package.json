{
  "name": "release-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Release Radar - GitHub release notifications for engineers",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --import tsx --watch server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=server/dist/index.js",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning server/dist/index.js",
    "db:migrate": "node --disable-warning=ExperimentalWarning --import tsx server/src/db/migrate-cli.ts",
    "db:reset": "node --disable-warning=ExperimentalWarning --import tsx server/src/db/reset-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "audit:secrets": "node tools/secret-scan.mjs --tracked"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "globals": "^16.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}