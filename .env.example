# Server configuration
NODE_ENV=development
PORT=3001
DATABASE_FILE=data/release-radar.db
SESSION_TTL_HOURS=168

# GitHub API (server-side only - NEVER commit a real token)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_FETCH_TIMEOUT_MS=15000
GITHUB_MAX_PAGES=20
GITHUB_USER_AGENT=release-radar

# Production settings
TRUST_PROXY=false
SERVE_CLIENT=false
CLIENT_DIST_DIR=../client/dist